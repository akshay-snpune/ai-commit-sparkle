{
  "name": "ai-commit-sparkle",
  "displayName": "AI Commit Message Generator",
  "description": "Generate conventional commit messages using AI (Ollama or OpenAI) with a sparkle button in the Source Control panel.",
  "version": "0.1.0",
  "publisher": "akshay-snpune",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Source Control",
    "AI"
  ],
  "keywords": [
    "git",
    "commit",
    "ai",
    "ollama",
    "openai",
    "conventional-commits",
    "sparkle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akshay-snpune/ai-commit-sparkle.git"
  },
  "bugs": {
    "url": "https://github.com/akshay-snpune/ai-commit-sparkle/issues"
  },
  "homepage": "https://github.com/akshay-snpune/ai-commit-sparkle#readme",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-commit-sparkle.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "AI Commit",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "ai-commit-sparkle.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "AI Commit Sparkle",
      "properties": {
        "aiCommitSparkle.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai"
          ],
          "default": "ollama",
          "description": "AI provider to use for commit message generation"
        },
        "aiCommitSparkle.ollama.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API endpoint URL"
        },
        "aiCommitSparkle.ollama.model": {
          "type": "string",
          "default": "mistral:latest",
          "description": "Ollama model to use (e.g., mistral:latest, neural-chat:latest)"
        },
        "aiCommitSparkle.openai.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key (leave empty to use OPENAI_API_KEY env var)"
        },
        "aiCommitSparkle.openai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI model to use (e.g., gpt-4o-mini, gpt-4-turbo)"
        },
        "aiCommitSparkle.customInstructions": {
          "type": "string",
          "default": "Use Conventional Commits: '<type>(<optional-scope>): <summary>' where type is one of feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert. Keep the subject under 72 characters. Be concise and clear.",
          "description": "Custom instructions for commit message generation"
        },
        "aiCommitSparkle.showNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when commit message is generated"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild -- --minify",
    "esbuild": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --target=node18 --format=cjs",
    "watch": "npm run esbuild -- --watch",
    "build": "npm run esbuild",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
